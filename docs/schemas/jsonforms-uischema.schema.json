{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JSON Forms UI schema — core and antd renderers",
  "description": "A UI schema for a host built on core plus the antd renderer set. This file is the source of truth for the shared vocabulary; jsonforms-extended-uischema.schema.json references it and widens it. It carries only the element types this set registers, and excludes the options that configure the extended renderers.\n\n`options.format` stays an open string, because it is a renderer-selection hint rather than an enumeration - but the values only the extended set answers to are excluded, which is as much as a schema can honestly enforce.\n\nKeeps what may look extended but is not: the temporal bound options and the whole layout sizing model belong to this set.\n\n`additionalProperties` stays true: unknown elements and options must be preserved and ignored at runtime, so an extended element is not *invalid* - it simply will not render. This file turns that silence into an authoring error.",
  "$ref": "#/$defs/element",
  "$defs": {
    "dimension": {
      "description": "A CSS length. A number means px.",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "uiSchema": {
      "$ref": "#/$defs/element"
    },
    "element": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Control",
            "VerticalLayout",
            "HorizontalLayout",
            "Group",
            "Categorization",
            "Category",
            "ListWithDetail",
            "Label"
          ],
          "description": "Only the element types the antd base renderer set registers."
        },
        "rule": {
          "$ref": "#/$defs/rule"
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        },
        "i18n": {
          "type": "string",
          "description": "Translation key for this element's own text."
        },
        "name": {
          "type": "string",
          "description": "Project extension. Core declares no `name` on an element, so this schema does - it addresses a template's children, and names a Button's action when it declares none. See Adjustment 27."
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/byType"
        },
        {
          "$ref": "#/$defs/layoutItemOptions"
        }
      ]
    },
    "byType": {
      "description": "Per-type shape. Written as if/then so an unknown `type` still validates - a renderer set downstream may contribute its own.",
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Control"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/control"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "VerticalLayout"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/layout"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "HorizontalLayout"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/horizontalLayout"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Group"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/group"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Categorization"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/categorization"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Category"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/category"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ListWithDetail"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/listWithDetail"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Label"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/label"
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": [
        "effect",
        "condition"
      ],
      "additionalProperties": false,
      "properties": {
        "effect": {
          "enum": [
            "HIDE",
            "SHOW",
            "ENABLE",
            "DISABLE"
          ]
        },
        "condition": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "layoutItemOptions": {
      "description": "Options a CHILD carries so its parent can size it. Distinct from the container options a layout carries for itself - see Adjustment 21.2.",
      "properties": {
        "options": {
          "type": "object",
          "properties": {
            "span": {
              "type": "integer",
              "minimum": 1,
              "description": "Columns of the parent's grid this child occupies."
            },
            "weight": {
              "type": "number",
              "description": "Share of free space, as flex-grow."
            },
            "width": {
              "$ref": "#/$defs/dimension"
            },
            "minWidth": {
              "$ref": "#/$defs/dimension"
            },
            "maxWidth": {
              "$ref": "#/$defs/dimension"
            },
            "height": {
              "$ref": "#/$defs/dimension"
            },
            "minHeight": {
              "$ref": "#/$defs/dimension"
            },
            "maxHeight": {
              "$ref": "#/$defs/dimension"
            },
            "start": {
              "type": "integer",
              "description": "Reserved by the specification; accepted and ignored here."
            },
            "responsive": {
              "description": "Reserved by the specification; accepted and ignored here."
            }
          }
        }
      }
    },
    "layoutContainerOptions": {
      "type": "object",
      "properties": {
        "gap": {
          "$ref": "#/$defs/dimension",
          "default": 16,
          "description": "Default gap between a layout's children. Direction-dependent by design: a non-zero row gutter, because two controls placed side by side would otherwise share an edge, and zero for a column, because controls that already carry a bottom margin would be double-spaced. An explicit gap on the element still wins, and 0 restores edge-sharing at either level."
        },
        "wrap": {
          "type": "boolean",
          "default": false
        },
        "minItemWidth": {
          "$ref": "#/$defs/dimension"
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ]
        },
        "justify": {
          "enum": [
            "start",
            "center",
            "end",
            "space-between",
            "space-around",
            "space-evenly"
          ]
        },
        "resizable": {
          "type": "boolean",
          "description": "Draws a splitter between children."
        }
      }
    },
    "layout": {
      "required": [
        "elements"
      ],
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "options": {
          "$ref": "#/$defs/layoutContainerOptions"
        }
      }
    },
    "horizontalLayout": {
      "required": [
        "elements"
      ],
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "options": {
          "allOf": [
            {
              "$ref": "#/$defs/layoutContainerOptions"
            }
          ],
          "properties": {
            "gridColumns": {
              "type": "integer",
              "minimum": 1,
              "default": 16,
              "description": "Horizontal layouts only. A child's `span` is read against this."
            }
          }
        }
      }
    },
    "group": {
      "required": [
        "elements"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "options": {
          "allOf": [
            {
              "$ref": "#/$defs/layoutContainerOptions"
            }
          ],
          "properties": {
            "collapsible": {
              "type": "boolean"
            },
            "collapsed": {
              "type": "boolean",
              "description": "Initial state only, not a controlled value."
            },
            "showBorder": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "categorization": {
      "required": [
        "elements"
      ],
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "options": {
          "type": "object",
          "properties": {
            "variant": {
              "enum": [
                "tabs",
                "stepper",
                "accordion"
              ],
              "default": "tabs"
            },
            "initial": {
              "description": "Which category opens first: a 0-based index or a category name.",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string"
                }
              ]
            }
          }
        }
      }
    },
    "category": {
      "required": [
        "elements"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      }
    },
    "control": {
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "description": "JSON Pointer into the schema, e.g. `#/properties/name`."
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "options": {
          "$ref": "#/$defs/controlOptions"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "options": {
                "properties": {
                  "format": {
                    "const": "date"
                  }
                },
                "required": [
                  "format"
                ]
              }
            },
            "required": [
              "options"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "properties": {
                  "views": {
                    "items": {
                      "enum": [
                        "year",
                        "month",
                        "day"
                      ]
                    }
                  }
                }
              }
            }
          },
          "description": "A date control offers calendar views only."
        },
        {
          "if": {
            "properties": {
              "options": {
                "properties": {
                  "format": {
                    "const": "time"
                  }
                },
                "required": [
                  "format"
                ]
              }
            },
            "required": [
              "options"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "properties": {
                  "views": {
                    "items": {
                      "enum": [
                        "hours",
                        "minutes",
                        "seconds"
                      ]
                    }
                  }
                }
              }
            }
          },
          "description": "A time control offers time columns only."
        },
        {
          "if": {
            "properties": {
              "options": {
                "properties": {
                  "format": {
                    "const": "date-time"
                  }
                },
                "required": [
                  "format"
                ]
              }
            },
            "required": [
              "options"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "properties": {
                  "views": {
                    "items": {
                      "enum": [
                        "year",
                        "month",
                        "day",
                        "hours",
                        "minutes",
                        "seconds"
                      ]
                    }
                  }
                }
              }
            }
          },
          "description": "A date-time control offers both."
        }
      ]
    },
    "controlOptions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Options a Control may carry. Which apply depends on the schema the scope resolves to; this schema does not try to correlate the two, because the renderer chosen depends on the data schema, not on the UI schema alone.",
      "properties": {
        "format": {
          "type": "string",
          "not": {
            "enum": [
              "code",
              "duration",
              "color"
            ]
          },
          "description": "Open, as in the full schema, minus the three values only the extended set can render.",
          "examples": [
            "radio",
            "date",
            "date-time",
            "time",
            "password",
            "table"
          ]
        },
        "variant": {
          "description": "Requests a presentation the automatic choice would not make. A reserved portable name and a dispatch input, which is why it is never namespaced.",
          "examples": [
            "radio",
            "chips",
            "multi-select",
            "autocomplete",
            "table",
            "tuple",
            "stepper",
            "accordion"
          ],
          "type": "string"
        },
        "focus": {
          "type": "boolean"
        },
        "clearable": {
          "type": "boolean"
        },
        "placeholder": {
          "type": "string"
        },
        "readonly": {
          "type": "boolean"
        },
        "restrict": {
          "type": "boolean",
          "description": "Prevention rather than only validation, for this control."
        },
        "multi": {
          "type": "boolean",
          "description": "Multi-line text."
        },
        "autocomplete": {
          "type": "boolean",
          "description": "Searchable choice entry."
        },
        "filter": {
          "description": "Choice filtering behaviour."
        },
        "trim": {
          "type": "boolean",
          "description": "Reserved; diagnosed rather than applied."
        },
        "detail": {
          "$ref": "#/$defs/detail"
        },
        "summary": {
          "$ref": "#/$defs/element",
          "description": "A scoped Control naming the property a composite cell shows in one line. NOT a format string."
        },
        "elementLabelProp": {
          "type": "string",
          "description": "Item-relative dotted DATA path for an item's header label - not a JSON pointer."
        },
        "childLabelProp": {
          "type": "string",
          "description": "Legacy alias of elementLabelProp. The specification says not to introduce an additional alias; it is read for compatibility."
        },
        "showSortButtons": {
          "type": "boolean",
          "default": false,
          "description": "Table and expandable: Move up/down. AG Grid: a drag-handle column."
        },
        "disableAdd": {
          "type": "boolean",
          "default": false
        },
        "disableRemove": {
          "type": "boolean",
          "default": false
        },
        "initCollapsed": {
          "type": "boolean",
          "default": false,
          "description": "Initialization only, not a controlled expansion value."
        },
        "collapseNewItems": {
          "type": "boolean",
          "default": false
        },
        "hideAvatar": {
          "type": "boolean",
          "default": false
        },
        "hideArraySummaryValidation": {
          "type": "boolean",
          "default": false,
          "description": "Hides the child-error summary only. Validation is unaffected, and the array's own error explanation remains."
        },
        "table": {
          "type": "boolean",
          "description": "Forces the table renderer for an array whose items nest, which the detail renderer would otherwise outrank."
        },
        "cells": {
          "type": "object",
          "description": "Per-column options handed to the composite cell, keyed by property name.",
          "additionalProperties": {
            "$ref": "#/$defs/cellOptions"
          }
        },
        "showEmptyButton": {
          "type": "boolean",
          "description": "Adds Clear to a composite detail dialog."
        },
        "emptyLabel": {
          "type": "string"
        },
        "okLabel": {
          "type": "string",
          "description": "Used as an i18n key first, literally if it does not resolve."
        },
        "cancelLabel": {
          "type": "string"
        },
        "confirmation": {
          "$ref": "#/$defs/confirmationOperations"
        },
        "showBorder": {
          "type": "boolean",
          "default": true,
          "description": "Tuple control: encloses the heading and positions."
        },
        "layout": {
          "description": "Tuple position layout.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array"
            },
            {
              "type": "object"
            }
          ]
        },
        "formatMinimum": {
          "description": "Temporal bound. May be a literal or an Ajv `$data` pointer."
        },
        "formatMaximum": {},
        "formatExclusiveMinimum": {},
        "formatExclusiveMaximum": {},
        "views": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "year",
              "month",
              "day",
              "hours",
              "minutes",
              "seconds"
            ]
          },
          "description": "Which panels the picker offers. Date views select the calendar's granularity; time views select which time columns are drawn. The finest date view named is where the calendar lands. It does not change the save format - a year/month picker storing a full date is a legitimate request, and asking for hours and minutes does not stop seconds being stored. An array naming no view of a kind the control uses leaves that half to the display format, rather than blanking it."
        },
        "saveFormat": {
          "type": "string",
          "description": "dayjs token string the committed value is written with. A format the schema's `format` would reject is diagnosed."
        },
        "height": {
          "$ref": "#/$defs/dimension"
        },
        "width": {
          "$ref": "#/$defs/dimension"
        },
        "map": {
          "description": "Map control configuration."
        }
      }
    },
    "cellOptions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "summary": {
          "$ref": "#/$defs/element"
        },
        "detail": {
          "$ref": "#/$defs/detail"
        },
        "showEmptyButton": {
          "type": "boolean"
        },
        "emptyLabel": {
          "type": "string"
        },
        "okLabel": {
          "type": "string"
        },
        "cancelLabel": {
          "type": "string"
        },
        "restrict": {
          "type": "boolean"
        }
      }
    },
    "confirmationOperations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "typeChange": {
          "enum": [
            "always",
            "never",
            "complex"
          ]
        },
        "branchChange": {
          "enum": [
            "always",
            "never",
            "complex"
          ]
        },
        "delete": {
          "enum": [
            "always",
            "never",
            "complex"
          ]
        }
      }
    },
    "listWithDetail": {
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "type": "string"
        },
        "options": {
          "type": "object",
          "properties": {
            "elementLabelProp": {
              "type": "string"
            },
            "detail": {
              "$ref": "#/$defs/detail"
            },
            "showSortButtons": {
              "type": "boolean",
              "default": false
            },
            "hideArraySummaryValidation": {
              "type": "boolean",
              "default": false
            },
            "restrict": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "label": {
      "properties": {
        "text": {
          "type": "string"
        },
        "options": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string"
            }
          }
        }
      }
    },
    "detail": {
      "description": "An item or object form. Either the literal `GENERATE`, a full element, or a layout given without a `type` - JSON Forms treats a bare `{ elements: [...] }` as a vertical layout, and fixtures rely on it. `anyOf`, not `oneOf`: a detail written WITH a `type` matches both the element branch and the bare-layout branch, and `oneOf` would call that ambiguity an error.",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "GENERATE"
          ]
        },
        {
          "$ref": "#/$defs/element"
        },
        {
          "type": "object",
          "required": [
            "elements"
          ],
          "additionalProperties": true,
          "properties": {
            "elements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/element"
              }
            }
          }
        }
      ]
    }
  }
}
