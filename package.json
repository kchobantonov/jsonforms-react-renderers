{
  "name": "jsonforms-react-renderers",
  "engines": {
    "node": "^22.0.0",
    "pnpm": ">=10.28.2"
  },
  "pnpm": {
    "overrides": {
      "ajv-formats": "^3.0.1",
      "ajv@>=8": "8.20.0",
      "enzyme>cheerio": "1.0.0-rc.12",
      "lodash": "^4.18.1",
      "dayjs": "1.11.13"
    }
  },
  "scripts": {
    "preparePublish": "pnpm run test:release && pnpm run release:pack",
    "merge-report": "mkdir -p coverage && lcov-result-merger 'packages/**/coverage/lcov.info' 'coverage/lcov.info' --prepend-source-files",
    "check-format": "prettier --check .",
    "example:antd:dev": "pnpm --filter jsonforms-react-antd-demo dev",
    "example:antd:build": "pnpm --filter jsonforms-react-antd-demo build",
    "example:primereact:dev": "pnpm --filter jsonforms-react-primereact-demo dev",
    "example:primereact:build": "pnpm --filter jsonforms-react-primereact-demo build",
    "example:shadcn:dev": "pnpm --filter jsonforms-react-shadcn-demo dev",
    "example:shadcn:build": "pnpm --filter jsonforms-react-shadcn-demo build",
    "example:mui:dev": "pnpm --filter jsonforms-react-mui-demo dev",
    "example:mui:build": "pnpm --filter jsonforms-react-mui-demo build",
    "wc:shadcn:build": "pnpm --filter @chobantonov/jsonforms-react-shadcn-webcomponent build",
    "wc:antd:build": "pnpm --filter @chobantonov/jsonforms-react-antd-webcomponent build",
    "wc:primereact:build": "pnpm --filter @chobantonov/jsonforms-react-primereact-webcomponent build",
    "wc:mui:build": "pnpm --filter @chobantonov/jsonforms-react-mui-webcomponent build",
    "build": "pnpm -r --if-present build",
    "build:antd": "pnpm --filter jsonforms-react-antd-demo... --if-present build",
    "build:primereact": "pnpm --filter jsonforms-react-primereact-demo... --if-present build",
    "build:mui": "pnpm --filter jsonforms-react-mui-demo... --if-present build",
    "build:shadcn": "pnpm --filter jsonforms-react-shadcn-demo... --if-present build",
    "build:libs": "pnpm --filter @chobantonov/jsonforms-react-renderer-common build && pnpm --filter @chobantonov/jsonforms-react-extended-renderers build && pnpm --filter @chobantonov/jsonforms-react-antd-renderers build && pnpm --filter @chobantonov/jsonforms-react-antd-extended-renderers build && pnpm --filter @chobantonov/jsonforms-react-antd-webcomponent build && pnpm --filter @chobantonov/jsonforms-react-primereact-renderers build && pnpm --filter @chobantonov/jsonforms-react-primereact-extended-renderers build && pnpm --filter @chobantonov/jsonforms-react-primereact-webcomponent build && pnpm --filter @chobantonov/jsonforms-react-shadcn-renderers build && pnpm --filter @chobantonov/jsonforms-react-shadcn-extended-renderers build && pnpm --filter @chobantonov/jsonforms-react-shadcn-webcomponent build && pnpm --filter @chobantonov/jsonforms-react-mui-extended-renderers build && pnpm --filter @chobantonov/jsonforms-react-mui-webcomponent build",
    "bundle": "pnpm -r --if-present bundle",
    "clean": "pnpm -r --if-present clean",
    "doc": "pnpm -r --if-present doc",
    "test": "pnpm -r --if-present test",
    "test:antd": "pnpm --filter jsonforms-react-antd-demo... --if-present test",
    "test:primereact": "pnpm --filter jsonforms-react-primereact-demo... --if-present test",
    "test:mui": "pnpm --filter jsonforms-react-mui-demo... --if-present test",
    "test:shadcn": "pnpm --filter jsonforms-react-shadcn-demo... --if-present test",
    "test-cov": "pnpm -r --if-present test-cov",
    "lint": "eslint packages apps scripts --ext .js,.cjs,.mjs,.ts,.tsx",
    "lint:fix": "pnpm lint --fix",
    "examples-app:build": "pnpm run example:antd:build && pnpm run example:primereact:build && pnpm run example:shadcn:build && pnpm run example:mui:build && node apps/jsonforms-react-examples-app/prepare-examples-app.js",
    "examples-app:dev": "pnpm run examples-app:build && pnpm --filter @chobantonov/jsonforms-react-examples-app dev",
    "examples-app:preview": "pnpm run examples-app:build && pnpm --filter @chobantonov/jsonforms-react-examples-app preview",
    "build:examples-app": "pnpm run examples-app:build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm run release:pack && changeset publish",
    "release:pack": "pnpm run build:libs && node scripts/pack-release.mjs",
    "test:release": "node --test scripts/test/*.test.mjs",
    "test:packed": "node scripts/test-packed-webcomponents.mjs",
    "shadcn:sync": "node scripts/sync-shadcn.mjs",
    "shadcn:check": "node scripts/sync-shadcn.mjs --check",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.16.5",
    "@babel/plugin-proposal-optional-chaining": "^7.16.5",
    "@changesets/cli": "^2.30.0",
    "@chobantonov/jsonforms-extended-spec": "link:../jsonforms-extended-spec",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/lodash": "^4.14.149",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.0",
    "core-js": "^3.9.1",
    "coveralls": "^3.0.9",
    "cross-env": "^7.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "istanbul-lib-coverage": "^3.2.0",
    "lcov-result-merger": "^3.1.0",
    "nan": "^2.14.2",
    "nyc": "^15.1.0",
    "playwright": "1.58.1",
    "prettier": "^2.8.4",
    "publint": "^0.3.17",
    "source-map-support": "0.5.16",
    "ts-node": "^10.4.0",
    "tslib": "^2.5.0",
    "typescript": "~4.9.5",
    "vite": "^5.4.21"
  },
  "private": true,
  "packageManager": "pnpm@10.28.2"
}
