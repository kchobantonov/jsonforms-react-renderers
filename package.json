{
  "name": "jsonforms-react-renderers",
  "engines": {
    "node": "^22.18.0",
    "pnpm": ">=10.28.2"
  },
  "scripts": {
    "preparePublish": "vp run test:release && vp run release:pack",
    "merge-report": "mkdir -p coverage && lcov-result-merger 'packages/**/coverage/lcov.info' 'coverage/lcov.info' --prepend-source-files",
    "check-format": "vp fmt --check .",
    "example:antd:dev": "vp run --filter jsonforms-react-antd-demo dev",
    "example:antd:build": "vp run --filter jsonforms-react-antd-demo build",
    "example:shadcn:dev": "vp run --filter jsonforms-react-shadcn-demo dev",
    "example:shadcn:build": "vp run --filter jsonforms-react-shadcn-demo build",
    "wc:shadcn:build": "vp run --filter @chobantonov/jsonforms-react-shadcn-webcomponent build",
    "wc:antd:build": "vp run --filter @chobantonov/jsonforms-react-antd-webcomponent build",
    "build": "vp run -r --cache --concurrency-limit 2 build",
    "build:antd": "vp run --filter jsonforms-react-antd-demo... build",
    "build:shadcn": "vp run --filter jsonforms-react-shadcn-demo... build",
    "build:libs": "vp run --cache --filter '@chobantonov/jsonforms-react-*-renderers' --filter '@chobantonov/jsonforms-react-*-webcomponent' --filter '@chobantonov/jsonforms-react-renderer-common' --concurrency-limit 2 build",
    "bundle": "vp run -r --concurrency-limit 2 bundle",
    "clean": "vp run -r --concurrency-limit 2 clean",
    "doc": "vp run -r --concurrency-limit 2 doc",
    "test": "vp test run",
    "test:antd": "vp run --filter jsonforms-react-antd-demo... test",
    "test:shadcn": "vp run --filter jsonforms-react-shadcn-demo... test",
    "test-cov": "vp run -r --concurrency-limit 2 test-cov",
    "lint": "vp lint packages apps scripts",
    "lint:fix": "vp run lint --fix",
    "examples-app:build": "vp run example:antd:build && vp run example:shadcn:build && node apps/jsonforms-react-examples-app/prepare-examples-app.js",
    "examples-app:dev": "vp run examples-app:build && vp run --filter @chobantonov/jsonforms-react-examples-app dev",
    "examples-app:preview": "vp run examples-app:build && vp run --filter @chobantonov/jsonforms-react-examples-app preview",
    "build:examples-app": "vp run examples-app:build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "vp run release:pack && changeset publish",
    "release:pack": "vp run build:libs && node scripts/pack-release.mjs",
    "test:release": "node --test scripts/test/*.test.mjs",
    "test:packed": "node scripts/test-packed-webcomponents.mjs",
    "shadcn:sync": "node scripts/sync-shadcn.mjs",
    "shadcn:check": "node scripts/sync-shadcn.mjs --check",
    "format": "vp fmt .",
    "check": "vp check"
  },
  "devDependencies": {
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.16.5",
    "@babel/plugin-proposal-optional-chaining": "^7.16.5",
    "@changesets/cli": "^2.30.0",
    "@chobantonov/jsonforms-extended-spec": "link:../jsonforms-extended-spec",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/lodash": "^4.14.149",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.0",
    "core-js": "^3.9.1",
    "coveralls": "^3.0.9",
    "cross-env": "^7.0.2",
    "istanbul-lib-coverage": "^3.2.0",
    "lcov-result-merger": "^3.1.0",
    "nan": "^2.14.2",
    "nyc": "^15.1.0",
    "playwright": "1.58.1",
    "publint": "^0.3.17",
    "source-map-support": "0.5.16",
    "ts-node": "^10.4.0",
    "tslib": "^2.5.0",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "^2.9.1"
  },
  "private": true,
  "packageManager": "pnpm@10.28.2"
}
