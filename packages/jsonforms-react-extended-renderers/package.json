{
  "name": "@chobantonov/jsonforms-react-extended-renderers",
  "version": "0.1.0",
  "description": "Extended Renderer Set for JSON Forms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kchobantonov/jsonforms-react-renderers.git",
    "directory": "packages/jsonforms-react-extended-renderers"
  },
  "bugs": "https://github.com/kchobantonov/jsonforms-react-renderers/issues",
  "homepage": "https://github.com/kchobantonov/jsonforms-react-renderers",
  "license": "MIT",
  "directories": {
    "src": "src"
  },
  "files": [
    "lib",
    "src"
  ],
  "keywords": [
    "extended",
    "renderer",
    "form",
    "forms",
    "json",
    "jsonforms",
    "frontend",
    "generator",
    "input",
    "renderengine",
    "jsonschema",
    "schema",
    "uischema",
    "layout",
    "customization"
  ],
  "main": "lib/jsonforms-react-extended.cjs.js",
  "module": "lib/jsonforms-react-extended.esm.js",
  "typings": "lib/index.d.ts",
  "dependencies": {
    "@babel/standalone": "^7.28.3",
    "@marcbachmann/cel-js": "^8.0.0",
    "@monaco-editor/react": "^4.6.0",
    "ag-grid-community": "36.1.0",
    "ag-grid-react": "36.1.0",
    "ajv": "^8.6.1",
    "ajv-errors": "^3.0.0",
    "ajv-i18n": "^4.2.0",
    "ajv-keywords": "^5.1.0",
    "dayjs": "^1.11.11",
    "lodash": "^4.18.1",
    "markdown-it": "^14.1.0",
    "ractive": "^1.4.4",
    "sucrase": "^3.35.0",
    "valtio": "^1.11.2",
    "@chobantonov/jsonforms-react-renderer-common": "workspace:*"
  },
  "peerDependencies": {
    "@jsonforms/core": "3.9.0-alpha.1",
    "@jsonforms/react": "3.9.0-alpha.1",
    "react": "^16.12.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@cfaester/enzyme-adapter-react-18": "^0.8.0",
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "@jsonforms/core": "3.9.0-alpha.1",
    "@jsonforms/react": "3.9.0-alpha.1",
    "@types/enzyme": "^3.10.3",
    "@types/lodash": "^4.14.178",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "catalog:",
    "enzyme": "^3.11.0",
    "jsdom": "^22.0.0",
    "jsdom-global": "^3.0.2",
    "nyc": "^15.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^3.0.2",
    "tslib": "^2.5.0",
    "typedoc": "~0.25.3",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@types/node": "^22.0.0",
    "vite-plus": "catalog:"
  },
  "scripts": {
    "build": "vp build && tsc --emitDeclarationOnly",
    "lint": "vp lint .",
    "lint:fix": "vp run lint --fix",
    "test": "vp test run",
    "clean": "rimraf lib coverage dist .nyc_output 2> /dev/null",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/jsonforms-react-extended.esm.js",
      "require": "./lib/jsonforms-react-extended.cjs.js"
    },
    "./ajv-localizers": {
      "types": "./lib/core/ajvI18n/localizers.d.ts",
      "import": "./lib/ajv-localizers.esm.js",
      "require": "./lib/ajv-localizers.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "ajv-localizers": [
        "lib/core/ajvI18n/localizers.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
