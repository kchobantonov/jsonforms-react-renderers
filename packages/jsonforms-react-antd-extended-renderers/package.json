{
  "name": "@chobantonov/jsonforms-react-antd-extended-renderers",
  "version": "0.1.0",
  "description": "Extended Ant Design renderers for JSON Forms React",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kchobantonov/jsonforms-react-renderers.git",
    "directory": "packages/jsonforms-react-antd-extended-renderers"
  },
  "bugs": "https://github.com/kchobantonov/jsonforms-react-renderers/issues",
  "homepage": "https://github.com/kchobantonov/jsonforms-react-renderers",
  "license": "MIT",
  "directories": {
    "src": "src"
  },
  "files": [
    "lib",
    "src"
  ],
  "keywords": [
    "antd",
    "react",
    "renderer",
    "jsonforms",
    "template",
    "actions"
  ],
  "main": "lib/jsonforms-react-antd-extended.cjs.js",
  "module": "lib/jsonforms-react-antd-extended.esm.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "vp build && tsc --emitDeclarationOnly && tsc --noEmit -p test/tsconfig.json",
    "clean": "rimraf lib coverage dist .nyc_output 2> /dev/null",
    "lint": "vp lint .",
    "lint:fix": "vp run lint --fix",
    "test": "vp test run",
    "test:watch": "vp test",
    "doc": "typedoc --name 'JSON Forms React Ant Design Extended Renderers' --excludeExternals --out docs src",
    "tsc": "tsc --build tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json"
  },
  "peerDependencies": {
    "@ant-design/icons": "6.3.2",
    "@chobantonov/jsonforms-react-antd-renderers": "workspace:*",
    "@chobantonov/jsonforms-react-extended-renderers": "workspace:*",
    "@jsonforms/core": "3.9.0-alpha.1",
    "@jsonforms/react": "3.9.0-alpha.1",
    "antd": "6.6.5",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@ant-design/icons": "6.3.2",
    "@chobantonov/jsonforms-react-antd-renderers": "workspace:*",
    "@chobantonov/jsonforms-react-extended-renderers": "workspace:*",
    "@jsonforms/core": "3.9.0-alpha.1",
    "@jsonforms/react": "3.9.0-alpha.1",
    "@monaco-editor/react": "^4.6.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "catalog:",
    "antd": "6.6.5",
    "jsdom": "^22.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^3.0.2",
    "tslib": "^2.5.0",
    "typedoc": "~0.25.3",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@types/node": "^22.0.0",
    "vite-plus": "catalog:",
    "ag-grid-react": "36.1.0"
  },
  "dependencies": {
    "maska": "^3.2.1",
    "@chobantonov/jsonforms-react-renderer-common": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
