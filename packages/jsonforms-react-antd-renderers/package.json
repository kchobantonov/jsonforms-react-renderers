{
  "name": "@chobantonov/jsonforms-react-antd-renderers",
  "version": "0.0.1",
  "description": "Ant Design Renderer Set for JSON Forms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kchobantonov/jsonforms-react-renderers.git",
    "directory": "packages/jsonforms-react-antd-renderers"
  },
  "bugs": "https://github.com/kchobantonov/jsonforms-react-renderers/issues",
  "homepage": "https://github.com/kchobantonov/jsonforms-react-renderers",
  "license": "MIT",
  "directories": {
    "src": "src"
  },
  "files": [
    "lib",
    "src"
  ],
  "keywords": [
    "antd",
    "renderer",
    "form",
    "forms",
    "json",
    "jsonforms",
    "frontend",
    "generator",
    "input",
    "renderengine",
    "jsonschema",
    "schema",
    "uischema",
    "layout",
    "customization"
  ],
  "main": "lib/jsonforms-react-antd.cjs.js",
  "module": "lib/jsonforms-react-antd.esm.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "vp build && tsc --emitDeclarationOnly && tsc --noEmit -p test/tsconfig.json",
    "clean": "rimraf lib coverage dist .nyc_output 2> /dev/null",
    "lint": "vp lint .",
    "lint:fix": "vp run lint --fix",
    "test": "vp test run",
    "test:watch": "vp test",
    "test-cov": "vp test run --coverage",
    "doc": "typedoc --name 'JSON Forms React Ant Design Renderers' --excludeExternals --out docs src",
    "tsc": "tsc --build tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json"
  },
  "dependencies": {
    "dayjs": "catalog:",
    "lodash": "catalog:",
    "@chobantonov/jsonforms-react-renderer-common": "workspace:*"
  },
  "peerDependencies": {
    "@ant-design/icons": "catalog:peers",
    "@jsonforms/core": "catalog:",
    "@jsonforms/react": "catalog:",
    "antd": "catalog:peers",
    "react": "catalog:peers",
    "react-dom": "catalog:peers"
  },
  "devDependencies": {
    "@ant-design/icons": "catalog:",
    "@cfaester/enzyme-adapter-react-18": "^0.8.0",
    "@jsonforms/core": "catalog:",
    "@jsonforms/react": "catalog:",
    "@types/enzyme": "^3.10.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "antd": "catalog:",
    "enzyme": "^3.11.0",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:",
    "vite-plus": "catalog:",
    "@chobantonov/jsonforms-extended-spec": "0.2.0",
    "@types/lodash": "^4.14.149"
  },
  "publishConfig": {
    "access": "public"
  }
}
