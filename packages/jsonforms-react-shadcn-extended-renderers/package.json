{
  "name": "@chobantonov/jsonforms-react-shadcn-extended-renderers",
  "version": "0.0.1",
  "description": "Extended Shadcn UI renderers for JSON Forms React",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kchobantonov/jsonforms-react-renderers.git",
    "directory": "packages/jsonforms-react-shadcn-extended-renderers"
  },
  "bugs": "https://github.com/kchobantonov/jsonforms-react-renderers/issues",
  "homepage": "https://github.com/kchobantonov/jsonforms-react-renderers",
  "license": "MIT",
  "directories": {
    "src": "src"
  },
  "files": [
    "lib",
    "src"
  ],
  "keywords": [
    "shadcn-ui",
    "shadcn",
    "react",
    "renderer",
    "jsonforms",
    "template",
    "actions"
  ],
  "main": "lib/jsonforms-react-shadcn-extended.cjs.js",
  "module": "lib/jsonforms-react-shadcn-extended.esm.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "vp build && tsc --emitDeclarationOnly",
    "clean": "rimraf lib coverage dist .nyc_output 2> /dev/null",
    "lint": "vp lint .",
    "lint:fix": "vp run lint --fix",
    "test": "vp test run",
    "test:watch": "vp test",
    "test-cov": "vp test run --coverage",
    "doc": "typedoc --name 'JSON Forms React Shadcn Extended Renderers' --excludeExternals --out docs src",
    "tsc": "tsc --build tsconfig.json"
  },
  "peerDependencies": {
    "@chobantonov/jsonforms-react-extended-renderers": "workspace:*",
    "@chobantonov/jsonforms-react-shadcn-renderers": "workspace:*",
    "@jsonforms/core": "catalog:",
    "@jsonforms/react": "catalog:",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "react": "catalog:peers",
    "react-dom": "catalog:peers"
  },
  "devDependencies": {
    "@chobantonov/jsonforms-react-extended-renderers": "workspace:*",
    "@chobantonov/jsonforms-react-shadcn-renderers": "workspace:*",
    "@jsonforms/core": "catalog:",
    "@jsonforms/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ag-grid-community": "catalog:",
    "ag-grid-react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:",
    "@chobantonov/jsonforms-extended-spec": "0.2.0",
    "@monaco-editor/react": "catalog:"
  },
  "dependencies": {
    "@chobantonov/jsonforms-react-renderer-common": "workspace:*",
    "lucide-react": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
