{
  "name": "@chobantonov/jsonforms-react-primereact-renderers",
  "version": "0.0.1",
  "description": "PrimeReact Renderer Set for JSON Forms",
  "repository": "https://github.com/kchobantonov/jsonforms-react-renderers",
  "bugs": "https://github.com/kchobantonov/jsonforms-react-renderers/issues",
  "homepage": "https://github.com/kchobantonov/jsonforms-react-renderers",
  "license": "MIT",
  "directories": {
    "example": "example",
    "src": "src"
  },
  "files": [
    "lib",
    "src"
  ],
  "keywords": [
    "primereact",
    "renderer",
    "form",
    "forms",
    "json",
    "jsonforms",
    "frontend",
    "generator",
    "input",
    "renderengine",
    "jsonschema",
    "schema",
    "uischema",
    "layout",
    "customization"
  ],
  "main": "lib/jsonforms-react-primereact.cjs.js",
  "module": "lib/jsonforms-react-primereact.esm.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "build:examples-app": "vite build --config vite.example.config.mjs",
    "dev": "vite --config vite.example.config.mjs",
    "clean": "rimraf lib coverage dist .nyc_output example/dist 2> /dev/null",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-cov": "vitest run --coverage",
    "doc": "typedoc --name 'JSON Forms React PrimeReact Renderers' --excludeExternals --out docs src",
    "tsc": "tsc --build tsconfig.json"
  },
  "dependencies": {
    "@date-io/dayjs": "^3.0.0",
    "dayjs": "^1.11.11",
    "lodash": "^4.17.21"
  },
  "peerDependencies": {
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "@jsonforms/core": "3.8.0",
    "@jsonforms/react": "3.8.0",
    "@types/react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "primereact": "^10.9.8",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "@jsonforms/core": "3.8.0",
    "@jsonforms/react": "3.8.0",
    "@rollup/plugin-commonjs": "^23.0.3",
    "@rollup/plugin-json": "^5.0.2",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-replace": "^5.0.1",
    "@types/enzyme": "^3.10.3",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^5.54.1",
    "@typescript-eslint/parser": "^5.54.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "2.1.9",
    "@cfaester/enzyme-adapter-react-18": "^0.8.0",
    "primereact": "^10.9.8",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "enzyme": "^3.11.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^8.7.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "jsdom": "^22.0.0",
    "prettier": "^2.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^3.0.2",
    "rollup": "^2.78.0",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-import-css": "^3.3.1",
    "rollup-plugin-typescript2": "^0.34.1",
    "rollup-plugin-visualizer": "^5.4.1",
    "tslib": "^2.5.0",
    "typedoc": "~0.25.3",
    "typescript": "~4.9.5",
    "vite": "^5.4.11",
    "vitest": "2.1.9"
  }
}
