{
  "name": "@chobantonov/jsonforms-react-mui-extended-renderers",
  "version": "0.0.1",
  "description": "Extended Material UI renderers for JSON Forms React",
  "repository": "https://github.com/kchobantonov/jsonforms-react-renderers",
  "bugs": "https://github.com/kchobantonov/jsonforms-react-renderers/issues",
  "homepage": "https://github.com/kchobantonov/jsonforms-react-renderers",
  "license": "MIT",
  "directories": {
    "src": "src"
  },
  "files": [
    "lib",
    "src"
  ],
  "keywords": [
    "mui",
    "material",
    "react",
    "renderer",
    "jsonforms",
    "template",
    "actions"
  ],
  "main": "lib/jsonforms-react-mui-extended.cjs.js",
  "module": "lib/jsonforms-react-mui-extended.esm.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "clean": "rimraf lib coverage dist .nyc_output 2> /dev/null",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "doc": "typedoc --name 'JSON Forms React MUI Extended Renderers' --excludeExternals --out docs src",
    "tsc": "tsc --build tsconfig.json"
  },
  "peerDependencies": {
    "@chobantonov/jsonforms-react-extended-renderers": "0.0.1",
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "@jsonforms/core": "3.8.0",
    "@jsonforms/material-renderers": "3.8.0",
    "@jsonforms/react": "3.8.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@chobantonov/jsonforms-react-extended-renderers": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@jsonforms/core": "3.8.0",
    "@jsonforms/material-renderers": "3.8.0",
    "@jsonforms/react": "3.8.0",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^5.54.1",
    "@typescript-eslint/parser": "^5.54.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^8.7.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "jsdom": "^22.0.0",
    "prettier": "^2.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^3.0.2",
    "tslib": "^2.5.0",
    "typedoc": "~0.25.3",
    "typescript": "~4.9.5",
    "vite": "^5.4.11",
    "vitest": "2.1.9"
  }
}
