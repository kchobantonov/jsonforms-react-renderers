{
  "name": "@chobantonov/jsonforms-react-shadcn-renderers",
  "version": "0.1.0",
  "description": "Shadcn UI renderers for JSON Forms React",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kchobantonov/jsonforms-react-renderers.git",
    "directory": "packages/jsonforms-react-shadcn-renderers"
  },
  "bugs": "https://github.com/kchobantonov/jsonforms-react-renderers/issues",
  "homepage": "https://github.com/kchobantonov/jsonforms-react-renderers",
  "license": "MIT",
  "directories": {
    "src": "src"
  },
  "files": [
    "lib",
    "src"
  ],
  "keywords": [
    "shadcn-ui",
    "shadcn",
    "react",
    "renderer",
    "jsonforms",
    "form"
  ],
  "main": "lib/jsonforms-react-shadcn.cjs.js",
  "module": "lib/jsonforms-react-shadcn.esm.js",
  "typings": "lib/index.d.ts",
  "dependencies": {
    "@chobantonov/jsonforms-react-renderer-common": "workspace:*",
    "date-fns": "4.4.0",
    "lucide-react": "1.37.0",
    "lodash": "^4.18.1"
  },
  "scripts": {
    "build": "vp build && tsc --emitDeclarationOnly",
    "clean": "rimraf lib coverage dist .nyc_output 2> /dev/null",
    "lint": "vp lint .",
    "lint:fix": "vp run lint --fix",
    "test": "vp test run",
    "test:watch": "vp test",
    "test-cov": "vp test run --coverage",
    "doc": "typedoc --name 'JSON Forms React Shadcn UI Renderers' --excludeExternals --out docs src",
    "tsc": "tsc --build tsconfig.json"
  },
  "peerDependencies": {
    "@jsonforms/core": "3.9.0-alpha.1",
    "@jsonforms/react": "3.9.0-alpha.1",
