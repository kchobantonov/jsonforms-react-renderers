    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "catalog:",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jsdom": "^22.0.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-day-picker": "10.0.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.12.3",
    "rimraf": "^3.0.2",
    "tailwind-merge": "3.6.0",
    "tslib": "^2.5.0",
    "typedoc": "~0.25.3",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@types/node": "^22.0.0",
    "vite-plus": "catalog:"
