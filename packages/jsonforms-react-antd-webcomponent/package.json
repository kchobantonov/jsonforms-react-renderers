{
  "name": "@chobantonov/jsonforms-react-antd-webcomponent",
  "version": "0.1.0",
  "description": "Ant Design-based JSON Forms React web component",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kchobantonov/jsonforms-react-renderers.git",
    "directory": "packages/jsonforms-react-antd-webcomponent"
  },
  "bugs": "https://github.com/kchobantonov/jsonforms-react-renderers/issues",
  "homepage": "https://github.com/kchobantonov/jsonforms-react-renderers",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "module": "dist/jsonforms-react-antd.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "vp build && vp build --config vite.standalone.config.mjs && tsc --emitDeclarationOnly && tsc --noEmit -p test/tsconfig.json",
    "clean": "rimraf dist lib 2> /dev/null",
    "lint": "vp lint .",
    "lint:fix": "vp run lint --fix",
    "test": "vp test run",
    "test:watch": "vp test",
    "tsc": "tsc --build tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test-cov": "vp test run --coverage"
  },
  "peerDependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@chobantonov/jsonforms-react-antd-extended-renderers": "workspace:*",
    "@chobantonov/jsonforms-react-antd-renderers": "workspace:*",
    "@jsonforms/core": "catalog:",
    "@jsonforms/react": "catalog:",
    "antd": "catalog:peers",
    "react": "catalog:peers",
    "react-dom": "catalog:peers"
  },
  "devDependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@chobantonov/jsonforms-react-antd-extended-renderers": "workspace:*",
    "@chobantonov/jsonforms-react-antd-renderers": "workspace:*",
    "@jsonforms/core": "catalog:",
    "@jsonforms/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "antd": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  },
  "dependencies": {
    "@chobantonov/jsonforms-react-renderer-common": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
