{
  "name": "@chobantonov/jsonforms-react-antd-webcomponent",
  "version": "0.1.0",
  "description": "Ant Design-based JSON Forms React web component",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kchobantonov/jsonforms-react-renderers.git",
    "directory": "packages/jsonforms-react-antd-webcomponent"
  },
  "bugs": "https://github.com/kchobantonov/jsonforms-react-renderers/issues",
  "homepage": "https://github.com/kchobantonov/jsonforms-react-renderers",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "module": "dist/jsonforms-react-antd.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "vp build && tsc --emitDeclarationOnly && tsc --noEmit -p test/tsconfig.json",
    "clean": "rimraf dist lib 2> /dev/null",
    "lint": "vp lint .",
    "lint:fix": "vp run lint --fix",
    "test": "vp test run",
    "test:watch": "vp test",
    "tsc": "tsc --build tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json"
  },
  "peerDependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@chobantonov/jsonforms-react-antd-extended-renderers": "workspace:*",
    "@chobantonov/jsonforms-react-antd-renderers": "workspace:*",
    "@jsonforms/core": "3.9.0-alpha.1",
    "@jsonforms/react": "3.9.0-alpha.1",
    "antd": "6.6.5",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@chobantonov/jsonforms-react-antd-extended-renderers": "workspace:*",
    "@chobantonov/jsonforms-react-antd-renderers": "workspace:*",
    "@jsonforms/core": "3.9.0-alpha.1",
    "@jsonforms/react": "3.9.0-alpha.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "antd": "6.6.5",
    "jsdom": "^22.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^3.0.2",
    "tslib": "^2.5.0",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@types/node": "^22.0.0",
    "vite-plus": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
