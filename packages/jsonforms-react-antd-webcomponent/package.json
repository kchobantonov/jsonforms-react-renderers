{
  "name": "@chobantonov/jsonforms-react-antd-webcomponent",
  "version": "0.0.1",
  "description": "Ant Design-based JSON Forms React web component",
  "repository": "https://github.com/kchobantonov/jsonforms-react-renderers",
  "bugs": "https://github.com/kchobantonov/jsonforms-react-renderers/issues",
  "homepage": "https://github.com/kchobantonov/jsonforms-react-renderers",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "module": "dist/jsonforms-react-antd.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && tsc --noEmit -p test/tsconfig.json",
    "clean": "rimraf dist lib 2> /dev/null",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsc": "tsc --build tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json"
  },
  "peerDependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@chobantonov/jsonforms-react-antd-extended-renderers": "0.0.1",
    "@chobantonov/jsonforms-react-antd-renderers": "0.0.1",
    "@jsonforms/core": "3.9.0-alpha.1",
    "@jsonforms/react": "3.9.0-alpha.1",
    "antd": "6.6.5",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@chobantonov/jsonforms-react-antd-extended-renderers": "workspace:*",
    "@chobantonov/jsonforms-react-antd-renderers": "workspace:*",
    "@jsonforms/core": "3.9.0-alpha.1",
    "@jsonforms/react": "3.9.0-alpha.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^5.54.1",
    "@typescript-eslint/parser": "^5.54.1",
    "antd": "6.6.5",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^8.7.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "jsdom": "^22.0.0",
    "prettier": "^2.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^3.0.2",
    "tslib": "^2.5.0",
    "typescript": "~4.9.5",
    "vite": "^5.4.11",
    "vitest": "2.1.9"
  }
}
