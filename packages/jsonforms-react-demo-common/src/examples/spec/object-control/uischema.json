{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Label",
      "text": "Three ways an object gets its layout"
    },
    {
      "type": "Control",
      "scope": "#/properties/identity"
    },
    {
      "type": "Control",
      "scope": "#/properties/contact",
      "options": {
        "detail": {
          "type": "HorizontalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/phone"
            },
            {
              "type": "Control",
              "scope": "#/properties/email"
            }
          ]
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/address"
    },
    {
      "type": "Control",
      "scope": "#/properties/handover",
      "options": {
        "detail": "GENERATE"
      }
    },
    {
      "type": "Separator"
    },
    {
      "type": "Label",
      "text": "A detail may be any layout, and may name only part of the object"
    },
    {
      "type": "Control",
      "scope": "#/properties/schedule",
      "options": {
        "detail": {
          "type": "Categorization",
          "elements": [
            {
              "type": "Category",
              "label": "Pickup",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/pickup"
                }
              ]
            },
            {
              "type": "Category",
              "label": "Appointment",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/appointment"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/notes",
      "options": {
        "detail": {
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/forCoordinator"
            }
          ]
        }
      }
    },
    {
      "type": "Separator"
    },
    {
      "type": "Label",
      "text": "The outermost element of a detail is the object control’s own frame"
    },
    {
      "type": "Control",
      "scope": "#/properties/compliance",
      "options": {
        "detail": {
          "type": "Group",
          "label": "Dropped, because it is outermost",
          "elements": [
            {
              "type": "Group",
              "label": "Kept, because it is inside",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/needsApproval"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/permit"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "type": "Separator"
    },
    {
      "type": "Label",
      "text": "Errors that belong to the object itself"
    },
    {
      "type": "Control",
      "scope": "#/properties/preferences"
    },
    {
      "type": "Control",
      "scope": "#/properties/routing"
    },
    {
      "type": "Control",
      "scope": "#/properties/billing"
    }
  ]
}
