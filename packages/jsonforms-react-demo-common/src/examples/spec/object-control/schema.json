{
  "type": "object",
  "title": "Consignee profile",
  "definitions": {
    "geo": {
      "type": "object",
      "title": "Coordinates",
      "properties": {
        "lat": {
          "type": "number",
          "title": "Latitude"
        },
        "lng": {
          "type": "number",
          "title": "Longitude"
        }
      }
    }
  },
  "properties": {
    "identity": {
      "type": "object",
      "title": "Identity",
      "description": "A plain object control: the layout is generated from the schema.",
      "required": [
        "legalName"
      ],
      "properties": {
        "legalName": {
          "type": "string",
          "title": "Legal name"
        },
        "tradingName": {
          "type": "string",
          "title": "Trading name"
        }
      }
    },
    "contact": {
      "type": "object",
      "title": "Contact",
      "description": "Laid out by options.detail on the control, with scopes relative to this object.",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email"
        },
        "phone": {
          "type": "string",
          "title": "Phone"
        }
      }
    },
    "address": {
      "type": "object",
      "title": "Address",
      "description": "Laid out by a registered detail UI schema, and nesting another object.",
      "required": [
        "city"
      ],
      "properties": {
        "line1": {
          "type": "string",
          "title": "Street"
        },
        "city": {
          "type": "string",
          "title": "City"
        },
        "postcode": {
          "type": "string",
          "title": "Postcode"
        },
        "geo": {
          "$ref": "#/definitions/geo"
        }
      }
    },
    "handover": {
      "type": "object",
      "title": "Handover",
      "description": "Has a registry entry, and a control that asks for GENERATE instead.",
      "properties": {
        "contactName": {
          "type": "string",
          "title": "Contact name"
        },
        "window": {
          "type": "string",
          "title": "Window"
        },
        "gateCode": {
          "type": "string",
          "title": "Gate code"
        }
      }
    },
    "schedule": {
      "type": "object",
      "title": "Schedule",
      "description": "A detail may be any layout, including a Categorization.",
      "properties": {
        "pickup": {
          "type": "string",
          "title": "Pickup"
        },
        "delivery": {
          "type": "string",
          "title": "Delivery"
        }
      }
    },
    "notes": {
      "type": "object",
      "title": "Notes",
      "description": "Its control carries a detail with no type, which is not a detail at all.",
      "properties": {
        "forDriver": {
          "type": "string",
          "title": "For driver"
        },
        "forWarehouse": {
          "type": "string",
          "title": "For warehouse"
        }
      }
    },
    "compliance": {
      "type": "object",
      "title": "Compliance",
      "description": "A detail whose outermost element is a Group, wrapping another Group.",
      "properties": {
        "hazmat": {
          "type": "string",
          "title": "Hazmat class"
        },
        "permit": {
          "type": "string",
          "title": "Permit"
        }
      }
    },
    "preferences": {
      "type": "object",
      "title": "Preferences",
      "description": "minProperties: 1, and empty. The failure belongs to the object, not to any field.",
      "minProperties": 1,
      "properties": {
        "language": {
          "type": "string",
          "title": "Language"
        },
        "timezone": {
          "type": "string",
          "title": "Timezone"
        }
      }
    },
    "routing": {
      "type": "object",
      "title": "Routing",
      "description": "additionalProperties: false, with a key the schema does not declare.",
      "additionalProperties": false,
      "properties": {
        "terminal": {
          "type": "string",
          "title": "Terminal"
        }
      }
    },
    "billing": {
      "type": "object",
      "title": "Billing",
      "description": "A purchase order requires a cost centre; this one has none.",
      "dependencies": {
        "purchaseOrder": [
          "costCentre"
        ]
      },
      "properties": {
        "purchaseOrder": {
          "type": "string",
          "title": "Purchase order"
        },
        "costCentre": {
          "type": "string",
          "title": "Cost centre"
        }
      }
    }
  }
}
