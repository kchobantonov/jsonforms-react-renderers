{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Label",
      "i18n": "intro"
    },
    {
      "type": "Control",
      "scope": "#/properties/script",
      "options": {
        "format": "code",
        "language": "javascript",
        "monaco": {
          "autoGrow": true,
          "minRows": 2,
          "maxRows": 10,
          "initActions": ["editor.action.formatDocument"]
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/markup",
      "options": {
        "format": "code",
        "language": "html",
        "monaco": {
          "rows": 10,
          "initActions": ["editor.action.formatDocument"]
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/document",
      "options": {
        "format": "code",
        "language": "json",
        "convertJson": true,
        "monaco": {
          "rows": 8
        }
      }
    }
  ]
}
