{
  "type": "VerticalLayout",
  "options": {
    "gap": "1.5rem"
  },
  "elements": [
    {
      "type": "Label",
      "text": "Horizontal splitter: the layout type is the direction"
    },
    {
      "type": "HorizontalLayout",
      "options": {
        "variant": "splitter",
        "height": "14rem"
      },
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/queue",
          "options": {
            "layout": {
              "weight": 2
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/detail"
        }
      ]
    },
    {
      "type": "Label",
      "text": "Vertical splitter: needs a definite height"
    },
    {
      "type": "VerticalLayout",
      "options": {
        "variant": "splitter",
        "height": "16rem"
      },
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/mapNote"
        },
        {
          "type": "Control",
          "scope": "#/properties/summary"
        }
      ]
    },
    {
      "type": "Label",
      "text": "resizable: false keeps the boundary, drops the dragging"
    },
    {
      "type": "HorizontalLayout",
      "options": {
        "variant": "splitter",
        "resizable": false,
        "height": "10rem"
      },
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/queue"
        },
        {
          "type": "Control",
          "scope": "#/properties/notes"
        }
      ]
    },
    {
      "type": "Label",
      "text": "A hidden pane leaves layout, separator and all"
    },
    {
      "type": "Control",
      "scope": "#/properties/showAudit"
    },
    {
      "type": "HorizontalLayout",
      "options": {
        "variant": "splitter",
        "height": "10rem"
      },
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/summary"
        },
        {
          "type": "Control",
          "scope": "#/properties/audit",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/showAudit",
              "schema": {
                "const": true
              }
            }
          }
        }
      ]
    },
    {
      "type": "Label",
      "text": "Three panes at 1 : 2 : 1, and a toggle that removes the middle"
    },
    {
      "type": "Control",
      "scope": "#/properties/showTeamPane"
    },
    {
      "type": "HorizontalLayout",
      "options": {
        "variant": "splitter",
        "height": "10rem"
      },
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/bookedBy",
          "options": {
            "layout": {
              "weight": 1
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/teamName",
          "options": {
            "layout": {
              "weight": 2
            }
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/showTeamPane",
              "schema": {
                "const": true
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/approvedBy",
          "options": {
            "layout": {
              "weight": 1
            }
          }
        }
      ]
    }
  ]
}
