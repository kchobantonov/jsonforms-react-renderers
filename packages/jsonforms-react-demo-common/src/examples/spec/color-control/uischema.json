{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Label",
      "text": "One color, four stored representations. Pick a color, then read the Data tab."
    },
    { "type": "Control", "scope": "#/properties/brandPrimary" },
    {
      "type": "Control",
      "scope": "#/properties/accentColor",
      "options": { "colorSaveFormat": "rgb" }
    },
    {
      "type": "Control",
      "scope": "#/properties/chartSeries",
      "options": { "colorSaveFormat": "hsb" }
    },
    { "type": "Control", "scope": "#/properties/highlight" },
    { "type": "Separator" },
    { "type": "Label", "text": "Transparency" },
    { "type": "Control", "scope": "#/properties/watermark" },
    {
      "type": "Control",
      "scope": "#/properties/legacyBadge",
      "options": { "colorSaveFormat": "hex3" }
    },
    { "type": "Separator" },
    { "type": "Label", "text": "Selection by UI option, and the picker on its own" },
    {
      "type": "Control",
      "scope": "#/properties/statusDot",
      "options": { "format": "color", "colorSaveFormat": "rgb" }
    },
    {
      "type": "Control",
      "scope": "#/properties/printSpot",
      "options": { "colorTextEntry": false }
    },
    { "type": "Separator" },
    { "type": "Label", "text": "A value this profile does not recognize" },
    { "type": "Control", "scope": "#/properties/importedTint" }
  ]
}
