{
  "type": "VerticalLayout",
  "options": {
    "gap": "1rem"
  },
  "elements": [
    {
      "type": "Label",
      "i18n": "intro"
    },
    {
      "type": "Categorization",
      "elements": [
        {
          "type": "Category",
          "name": "table",
          "i18n": "tableTab",
          "label": "Table",
          "elements": [
            {
              "type": "Label",
              "i18n": "table"
            },
            {
              "type": "Control",
              "scope": "#/properties/sessions",
              "options": {
                "table": true,
                "showSortButtons": true,
                "cells": {
                  "room": {
                    "summary": {
                      "type": "Control",
                      "scope": "#/properties/name"
                    },
                    "detail": {
                      "type": "VerticalLayout",
                      "elements": [
                        {
                          "type": "Control",
                          "scope": "#/properties/name"
                        },
                        {
                          "type": "Control",
                          "scope": "#/properties/floor"
                        }
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "type": "Category",
          "name": "expandable",
          "i18n": "expandableTab",
          "label": "Expandable",
          "elements": [
            {
              "type": "Label",
              "i18n": "expandable"
            },
            {
              "type": "Control",
              "scope": "#/properties/speakers",
              "options": {
                "elementLabelProp": "name",
                "showSortButtons": true,
                "detail": {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/name"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/track"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/bio",
                      "options": {
                        "multi": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/links"
                    }
                  ]
                }
              }
            },
            {
              "type": "Label",
              "i18n": "expandableOptions"
            },
            {
              "type": "Control",
              "scope": "#/properties/announcements",
              "options": {
                "elementLabelProp": "text",
                "initCollapsed": true,
                "collapseNewItems": true,
                "hideAvatar": true,
                "hideArraySummaryValidation": true
              }
            }
          ]
        },
        {
          "type": "Category",
          "name": "listWithDetail",
          "i18n": "listTab",
          "label": "List with detail",
          "elements": [
            {
              "type": "Label",
              "i18n": "list"
            },
            {
              "type": "ListWithDetail",
              "scope": "#/properties/sponsors",
              "options": {
                "elementLabelProp": "name",
                "detail": {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/name"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/tier"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/notes",
                      "options": {
                        "multi": true
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Category",
          "name": "grid",
          "i18n": "gridTab",
          "label": "AG Grid",
          "elements": [
            {
              "type": "Label",
              "i18n": "grid"
            },
            {
              "type": "Control",
              "scope": "#/properties/tickets",
              "options": {
                "variant": "ag-grid",
                "showSortButtons": true,
                "height": 260,
                "cells": {
                  "holder": {
                    "summary": {
                      "type": "Control",
                      "scope": "#/properties/name"
                    },
                    "detail": {
                      "type": "VerticalLayout",
                      "elements": [
                        {
                          "type": "Control",
                          "scope": "#/properties/name"
                        },
                        {
                          "type": "Control",
                          "scope": "#/properties/email"
                        }
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "type": "Category",
          "name": "cells",
          "label": "Scalar and composite cells",
          "i18n": "cellsTab",
          "elements": [
            {
              "type": "Label",
              "i18n": "cells"
            },
            {
              "type": "Control",
              "scope": "#/properties/staff",
              "options": {
                "table": true,
                "showSortButtons": true,
                "cells": {
                  "address": {
                    "summary": {
                      "type": "Control",
                      "scope": "#/properties/street"
                    },
                    "showEmptyButton": true,
                    "detail": {
                      "type": "VerticalLayout",
                      "elements": [
                        {
                          "type": "Control",
                          "scope": "#/properties/street"
                        },
                        {
                          "type": "Control",
                          "scope": "#/properties/city"
                        }
                      ]
                    }
                  },
                  "phoneNumbers": {
                    "summary": {
                      "type": "Control",
                      "scope": "#"
                    },
                    "detail": {
                      "type": "Control",
                      "scope": "#"
                    },
                    "showEmptyButton": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/staff",
              "options": {
                "variant": "ag-grid",
                "height": 430,
                "showSortButtons": true,
                "cells": {
                  "address": {
                    "summary": {
                      "type": "Control",
                      "scope": "#/properties/street"
                    },
                    "showEmptyButton": true,
                    "detail": {
                      "type": "VerticalLayout",
                      "elements": [
                        {
                          "type": "Control",
                          "scope": "#/properties/street"
                        },
                        {
                          "type": "Control",
                          "scope": "#/properties/city"
                        }
                      ]
                    }
                  },
                  "phoneNumbers": {
                    "summary": {
                      "type": "Control",
                      "scope": "#"
                    },
                    "detail": {
                      "type": "Control",
                      "scope": "#"
                    },
                    "showEmptyButton": true
                  }
                },
                "agGridOptions": {
                  "pagination": true,
                  "paginationPageSize": 1,
                  "paginationPageSizeSelector": [
                    1,
                    2,
                    10
                  ],
                  "columnDefs": [
                    {
                      "field": "name",
                      "width": 170
                    },
                    {
                      "field": "age",
                      "width": 170
                    },
                    {
                      "field": "role",
                      "width": 170
                    },
                    {
                      "field": "badge",
                      "width": 170
                    },
                    {
                      "field": "tenure",
                      "width": 170
                    },
                    {
                      "field": "date",
                      "width": 170
                    },
                    {
                      "field": "time",
                      "width": 170
                    },
                    {
                      "field": "dateTime",
                      "width": 240
                    },
                    {
                      "field": "active",
                      "width": 170,
                      "filter": false
                    },
                    {
                      "field": "address",
                      "width": 240,
                      "filter": false
                    },
                    {
                      "field": "phoneNumbers",
                      "width": 240,
                      "filter": false
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Category",
          "name": "bounds",
          "i18n": "boundsTab",
          "label": "Add, remove and bounds",
          "elements": [
            {
              "type": "Label",
              "i18n": "bounds"
            },
            {
              "type": "Control",
              "scope": "#/properties/rounds",
              "options": {
                "elementLabelProp": "name",
                "showSortButtons": true
              }
            },
            {
              "type": "Label",
              "i18n": "disabled"
            },
            {
              "type": "Control",
              "scope": "#/properties/checklist",
              "options": {
                "disableAdd": true,
                "disableRemove": true
              }
            },
            {
              "type": "Label",
              "i18n": "contains"
            },
            {
              "type": "Control",
              "scope": "#/properties/reviewers"
            }
          ]
        }
      ]
    }
  ]
}
