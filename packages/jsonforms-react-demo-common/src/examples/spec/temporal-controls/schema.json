{
  "type": "object",
  "properties": {
    "schemaBased": {
      "type": "object",
      "title": "Selected by the schema",
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "title": "Appointment date",
          "description": "format: date. Validated as a calendar date."
        },
        "time": {
          "type": "string",
          "format": "time",
          "title": "Start time",
          "description": "format: time. RFC 3339 requires seconds and an offset."
        },
        "datetime": {
          "type": "string",
          "format": "date-time",
          "title": "Send reminder at",
          "description": "format: date-time."
        },
        "duration": {
          "type": "string",
          "format": "duration",
          "title": "Session length",
          "description": "format: duration. An ISO 8601 period."
        },
        "timeWithSeconds": {
          "type": "string",
          "format": "time",
          "title": "Start time, to the second",
          "description": "The same format keyword, with seconds on screen."
        }
      },
      "required": [
        "date"
      ]
    },
    "uiSchemaBased": {
      "type": "object",
      "title": "Selected by the UI schema",
      "properties": {
        "month": {
          "type": "string",
          "title": "Renewal month",
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "description": "A plain string. Only `pattern` validates it."
        },
        "time": {
          "type": "string",
          "title": "Opening time",
          "description": "A plain string shown on a twelve-hour clock."
        },
        "datetime": {
          "type": "string",
          "title": "Published at",
          "description": "A plain string stored in a house format."
        },
        "timeSeconds": {
          "type": "string",
          "title": "Opening time, to the second",
          "description": "A plain string storing HH:mm:ss."
        },
        "datetimeSeconds": {
          "type": "string",
          "title": "Published at, to the second",
          "description": "A plain string storing seconds in a house format."
        },
        "coarseTime": {
          "type": "string",
          "title": "Collection window",
          "description": "Stores seconds, but is chosen to the minute. `views` and the save format are independent."
        }
      }
    },
    "bounded": {
      "type": "object",
      "title": "Restricting the range",
      "properties": {
        "bookingDate": {
          "type": "string",
          "format": "date",
          "title": "Booking date",
          "formatMinimum": "2026-10-01",
          "formatMaximum": "2026-10-31"
        },
        "notBefore": {
          "type": "string",
          "format": "date",
          "title": "Strictly after 19 October",
          "formatExclusiveMinimum": "2026-10-19"
        },
        "officeHours": {
          "type": "string",
          "format": "time",
          "title": "Within office hours",
          "formatMinimum": "09:00:00Z",
          "formatMaximum": "17:00:00Z"
        },
        "slot": {
          "type": "string",
          "format": "date-time",
          "title": "Appointment slot",
          "formatMinimum": "2026-10-05T09:00:00Z",
          "formatMaximum": "2026-10-09T17:00:00Z"
        },
        "unrestricted": {
          "type": "string",
          "format": "date",
          "title": "Same bounds, restrict off",
          "formatMinimum": "2026-10-01",
          "formatMaximum": "2026-10-31"
        }
      }
    },
    "composed": {
      "type": "object",
      "title": "In other structures",
      "properties": {
        "bookingPeriod": {
          "$ref": "#/$defs/dateRange",
          "title": "Booking period"
        },
        "reportPeriod": {
          "$ref": "#/$defs/dateRange",
          "title": "Report period"
        },
        "tupleRange": {
          "type": "array",
          "title": "Cover (tuple)",
          "prefixItems": [
            {
              "type": "string",
              "format": "date",
              "title": "From"
            },
            {
              "type": "string",
              "format": "date",
              "title": "To"
            }
          ],
          "minItems": 2
        },
        "legacyTupleRange": {
          "type": "array",
          "title": "Cover (draft-07 tuple)",
          "items": [
            {
              "type": "string",
              "format": "date",
              "title": "From"
            },
            {
              "type": "string",
              "format": "date",
              "title": "To"
            }
          ],
          "additionalItems": false,
          "minItems": 2
        },
        "maybeDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "title": "Optional date"
        }
      }
    }
  },
  "$defs": {
    "dateRange": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date",
          "title": "From"
        },
        "to": {
          "type": "string",
          "format": "date",
          "title": "To",
          "formatMinimum": {
            "$data": "1/from"
          }
        }
      },
      "required": [
        "from",
        "to"
      ]
    }
  }
}
