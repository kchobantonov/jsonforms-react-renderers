{
  "type": "Categorization",
  "elements": [
    {
      "type": "Category",
      "label": "Interpolation",
      "elements": [
        {
          "type": "Label",
          "i18n": "product",
          "text": "You are subscribed to {product}.",
          "options": {
            "interpolate": true,
            "textParams": {
              "product": "Atlas"
            }
          }
        },
        {
          "type": "Label",
          "i18n": "seats",
          "text": "Your plan includes {seats} {seats == 1 ? \"seat\" : \"seats\"}.",
          "options": {
            "interpolate": true,
            "textParams": {
              "seats": "{data.seats}"
            }
          }
        },
        {
          "type": "Label",
          "i18n": "promo",
          "text": "Promotional code: {code}",
          "options": {
            "interpolate": true,
            "textParams": {
              "code": "{data.promoCode}"
            }
          }
        },
        {
          "type": "Label",
          "i18n": "literal",
          "text": "Write {{seats}} to show a placeholder without resolving it.",
          "options": {
            "interpolate": true
          }
        },
        {
          "type": "Separator"
        },
        {
          "type": "HorizontalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/seats"
            },
            {
              "type": "Control",
              "scope": "#/properties/promoCode"
            }
          ]
        }
      ]
    },
    {
      "type": "Category",
      "label": "Markdown",
      "elements": [
        {
          "type": "Label",
          "i18n": "renewal",
          "text": "Invoices are issued on the **first working day** of each month. See the [billing terms](https://example.com/billing).",
          "options": {
            "markup": "markdown"
          }
        }
      ]
    },
    {
      "type": "Category",
      "label": "Both together",
      "elements": [
        {
          "type": "Label",
          "i18n": "summary",
          "text": "**{account}** is on the {plan} plan, and the next invoice is {amount}.",
          "options": {
            "interpolate": true,
            "markup": "markdown",
            "textParams": {
              "account": "{data.customerName}",
              "plan": "{translate(\"plan.\" + data.plan)}",
              "amount": "{currency(data.amountDue, \"EUR\")}"
            }
          }
        },
        {
          "type": "Label",
          "i18n": "holder",
          "text": "Account holder: {holder}",
          "options": {
            "interpolate": true,
            "markup": "markdown",
            "textParams": {
              "holder": "{data.displayName}"
            }
          }
        },
        {
          "type": "Separator"
        },
        {
          "type": "HorizontalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/customerName"
            },
            {
              "type": "Control",
              "scope": "#/properties/plan"
            }
          ]
        },
        {
          "type": "HorizontalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/amountDue"
            },
            {
              "type": "Control",
              "scope": "#/properties/displayName"
            }
          ]
        }
      ]
    },
    {
      "type": "Category",
      "label": "Locale and translation",
      "elements": [
        {
          "type": "Label",
          "i18n": "planName",
          "text": "Your plan is {plan}.",
          "options": {
            "interpolate": true,
            "textParams": {
              "plan": "{translate(\"plan.\" + data.plan)}"
            }
          }
        },
        {
          "type": "Label",
          "i18n": "renews",
          "text": "It renews on {renewal}.",
          "options": {
            "interpolate": true,
            "textParams": {
              "renewal": "{date(data.renewalDate)}"
            }
          }
        },
        {
          "type": "Label",
          "i18n": "price",
          "text": "Seat price {price}, or {beforeTax} before tax.",
          "options": {
            "interpolate": true,
            "textParams": {
              "price": "{currency(data.seatPrice, \"EUR\")}",
              "beforeTax": "{number(data.seatPrice, 2)}"
            }
          }
        },
        {
          "type": "Label",
          "i18n": "reference",
          "text": "Reference {ref} is not a quantity, so it is not formatted.",
          "options": {
            "interpolate": true,
            "textParams": {
              "ref": "{data.reference}"
            }
          }
        },
        {
          "type": "Separator"
        },
        {
          "type": "HorizontalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/plan"
            },
            {
              "type": "Control",
              "scope": "#/properties/renewalDate"
            }
          ]
        },
        {
          "type": "HorizontalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/seatPrice"
            },
            {
              "type": "Control",
              "scope": "#/properties/reference"
            }
          ]
        }
      ]
    },
    {
      "type": "Category",
      "label": "Interpolation off",
      "elements": [
        {
          "type": "Label",
          "i18n": "offPlain",
          "text": "Without interpolate, {product} and {data.customerName} are just characters."
        },
        {
          "type": "Label",
          "i18n": "offParams",
          "text": "Declared parameters are inert too: {product}.",
          "options": {
            "textParams": {
              "product": "Atlas"
            }
          }
        },
        {
          "type": "Separator"
        },
        {
          "type": "Control",
          "scope": "#/properties/customerName"
        }
      ]
    },
    {
      "type": "Category",
      "label": "JavaScript names",
      "elements": [
        {
          "type": "Label",
          "i18n": "ctor",
          "text": "A property called constructor: \"{ctor}\".",
          "options": {
            "interpolate": true,
            "textParams": {
              "ctor": "{data.constructor}"
            }
          }
        },
        {
          "type": "Label",
          "i18n": "ctorSibling",
          "text": "Its siblings are still readable: \"{account}\".",
          "options": {
            "interpolate": true,
            "textParams": {
              "account": "{data.customerName}"
            }
          }
        },
        {
          "type": "Label",
          "i18n": "tostring",
          "text": "And a property called toString: \"{ts}\".",
          "options": {
            "interpolate": true,
            "textParams": {
              "ts": "{data.toString}"
            }
          }
        },
        {
          "type": "Separator"
        },
        {
          "type": "HorizontalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/constructor"
            },
            {
              "type": "Control",
              "scope": "#/properties/toString"
            }
          ]
        },
        {
          "type": "Control",
          "scope": "#/properties/customerName"
        }
      ]
    },
    {
      "type": "Category",
      "label": "Incorrect usage",
      "elements": [
        {
          "type": "Label",
          "i18n": "direct",
          "text": "A data path in the text: \"{data.customerName}\".",
          "options": {
            "interpolate": true
          }
        },
        {
          "type": "Label",
          "i18n": "undeclared",
          "text": "A parameter that was never declared: \"{customer}\".",
          "options": {
            "interpolate": true,
            "textParams": {
              "account": "{data.customerName}"
            }
          }
        },
        {
          "type": "Label",
          "i18n": "unknownFn",
          "text": "A function that does not exist: \"{shout(account)}\".",
          "options": {
            "interpolate": true,
            "textParams": {
              "account": "{data.customerName}"
            }
          }
        },
        {
          "type": "Label",
          "i18n": "badNamespace",
          "text": "A namespace that does not exist: \"{who}\".",
          "options": {
            "interpolate": true,
            "textParams": {
              "who": "{nowhere.name}"
            }
          }
        },
        {
          "type": "Label",
          "i18n": "reserved",
          "text": "A parameter named after a reserved name: \"{locale}\".",
          "options": {
            "interpolate": true,
            "textParams": {
              "locale": "{data.plan}"
            }
          }
        },
        {
          "type": "Separator"
        },
        {
          "type": "Control",
          "scope": "#/properties/customerName"
        }
      ]
    }
  ]
}
