{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Label",
      "text": "Strings the plain text control already handles."
    },
    {
      "type": "Control",
      "scope": "#/properties/driverName",
      "options": { "placeholder": "Family name first" }
    },
    {
      "type": "Control",
      "scope": "#/properties/pickupCity",
      "options": {
        "suggestion": ["Portland", "Seattle", "Sacramento", "Salt Lake City"]
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/deliveryNotes",
      "options": { "multi": true }
    },
    { "type": "Separator" },
    {
      "type": "Label",
      "text": "Masked strings. How a value is typed and how it is stored are separate decisions."
    },
    {
      "type": "Control",
      "scope": "#/properties/bookingReference",
      "options": { "mask": "###-###" }
    },
    {
      "type": "Control",
      "scope": "#/properties/contactPhone",
      "options": {
        "mask": "+1 (###) ###-####",
        "returnMaskedValue": true,
        "placeholder": "+1 (503) 555-0142"
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/accountNumber",
      "options": { "mask": ["#### ####", "#### #### ####"] }
    },
    { "type": "Separator" },
    { "type": "Label", "text": "Custom tokens, and eager separators." },
    {
      "type": "Control",
      "scope": "#/properties/deckPosition",
      "options": { "mask": "D-##", "tokens": { "D": "[A-C]" } }
    },
    {
      "type": "Control",
      "scope": "#/properties/bayLabel",
      "options": { "mask": "AAAA", "tokens": { "A": "\\p{L}" } }
    },
    {
      "type": "Control",
      "scope": "#/properties/gateCode",
      "options": { "mask": "##-##", "eager": true }
    },
    { "type": "Separator" },
    {
      "type": "Label",
      "text": "A value the mask cannot carry, and a mask option that is not a mask."
    },
    {
      "type": "Control",
      "scope": "#/properties/legacyReference",
      "options": { "mask": "###-###" }
    },
    {
      "type": "Control",
      "scope": "#/properties/scheduledPickup",
      "options": { "mask": false }
    }
  ]
}
