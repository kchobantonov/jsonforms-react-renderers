{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Label",
      "text": "One policy, every renderer. Config sets it; an element may override it."
    },
    { "type": "Control", "scope": "#/properties/notes" },
    { "type": "Control", "scope": "#/properties/lines" },
    {
      "type": "Control",
      "scope": "#/properties/quietLines",
      "options": { "confirmation": { "delete": "never" } }
    },
    { "type": "Separator" },
    {
      "type": "Label",
      "text": "The same delete, in the other array renderers"
    },
    { "type": "Control", "scope": "#/properties/milestones" },
    { "type": "ListWithDetail", "scope": "#/properties/coordinators" },
    {
      "type": "Control",
      "scope": "#/properties/charges",
      "options": { "variant": "ag-grid" }
    },
    { "type": "Separator" },
    {
      "type": "Label",
      "text": "Type changes: complex asks only for a nonempty container. Tree Delete always asks."
    },
    { "type": "Control", "scope": "#/properties/payload" },
    { "type": "Control", "scope": "#/properties/scalar" },
    { "type": "Separator" },
    { "type": "Label", "text": "Branch changes" },
    { "type": "Control", "scope": "#/properties/contact" }
  ]
}
