{
  "type": "VerticalLayout",
  "options": { "gap": "1rem" },
  "elements": [
    {
      "type": "Group",
      "label": "Identity",
      "elements": [
        {
          "type": "HorizontalLayout",
          "options": { "gap": "1rem" },
          "elements": [
            { "type": "Control", "scope": "#/properties/legalName", "options": { "layout": { "span": 10 } } },
            { "type": "Control", "scope": "#/properties/memberNumber", "options": { "layout": { "span": 6 } } }
          ]
        }
      ]
    },
    {
      "type": "Group",
      "label": "Contact",
      "options": { "collapsible": true, "showDataIndicator": true },
      "elements": [
        { "type": "Control", "scope": "#/properties/contactName" },
        { "type": "Control", "scope": "#/properties/contactEmail" },
        {
          "type": "Group",
          "label": "Additional details",
          "options": { "collapsible": true, "collapsed": true, "showDataIndicator": true },
          "elements": [
            { "type": "Control", "scope": "#/properties/alternatePhone" },
            { "type": "Control", "scope": "#/properties/afterHours" }
          ]
        }
      ]
    },
    {
      "type": "Group",
      "label": "Insurance",
      "options": { "collapsible": true, "collapsed": true, "showDataIndicator": true },
      "elements": [
        { "type": "Control", "scope": "#/properties/insurer" },
        { "type": "Control", "scope": "#/properties/policyNumber" }
      ]
    },
    {
      "type": "Group",
      "label": "Audit",
      "options": { "collapsed": true },
      "elements": [{ "type": "Control", "scope": "#/properties/auditNote" }]
    }
  ]
}
