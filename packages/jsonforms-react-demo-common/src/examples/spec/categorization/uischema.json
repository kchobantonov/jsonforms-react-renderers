{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Label",
      "text": "Toggle this to watch the Business category appear and disappear in all three.",
      "i18n": "hint.visibility"
    },
    {
      "type": "Control",
      "scope": "#/properties/isBusiness"
    },
    {
      "type": "Separator"
    },
    {
      "type": "Label",
      "text": "Tabs — no variant",
      "i18n": "hint.tabs"
    },
    {
      "type": "Categorization",
      "elements": [
        {
          "type": "Category",
          "name": "contact",
          "label": "Contact",
          "i18n": "category.contact",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/contactName"
            },
            {
              "type": "Control",
              "scope": "#/properties/contactPhone"
            }
          ]
        },
        {
          "type": "Category",
          "name": "planning",
          "label": "Planning",
          "i18n": "category.planning",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/pickupCity"
            },
            {
              "type": "Control",
              "scope": "#/properties/dropoffCity"
            },
            {
              "type": "Control",
              "scope": "#/properties/itemCount"
            }
          ]
        },
        {
          "type": "Category",
          "name": "business",
          "label": "Business",
          "i18n": "category.business",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/companyName"
            }
          ],
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/isBusiness",
              "schema": {
                "const": true
              },
              "failWhenUndefined": true
            }
          }
        },
        {
          "type": "Category",
          "name": "notes",
          "label": "Notes",
          "i18n": "category.notes",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/notes"
            }
          ]
        }
      ]
    },
    {
      "type": "Separator"
    },
    {
      "type": "Label",
      "text": "Stepper — variant: \"stepper\"",
      "i18n": "hint.stepper"
    },
    {
      "type": "Categorization",
      "options": {
        "variant": "stepper",
        "showNavButtons": true
      },
      "elements": [
        {
          "type": "Category",
          "name": "contact",
          "label": "Contact",
          "i18n": "category.contact",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/contactName"
            },
            {
              "type": "Control",
              "scope": "#/properties/contactPhone"
            }
          ]
        },
        {
          "type": "Category",
          "name": "planning",
          "label": "Planning",
          "i18n": "category.planning",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/pickupCity"
            },
            {
              "type": "Control",
              "scope": "#/properties/dropoffCity"
            },
            {
              "type": "Control",
              "scope": "#/properties/itemCount"
            }
          ]
        },
        {
          "type": "Category",
          "name": "business",
          "label": "Business",
          "i18n": "category.business",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/companyName"
            }
          ],
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/isBusiness",
              "schema": {
                "const": true
              },
              "failWhenUndefined": true
            }
          }
        },
        {
          "type": "Category",
          "name": "notes",
          "label": "Notes",
          "i18n": "category.notes",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/notes"
            }
          ]
        }
      ]
    },
    {
      "type": "Separator"
    },
    {
      "type": "Label",
      "text": "Accordion — variant: \"accordion\"",
      "i18n": "hint.accordion"
    },
    {
      "type": "Categorization",
      "options": {
        "variant": "accordion",
        "initial": "planning"
      },
      "elements": [
        {
          "type": "Category",
          "name": "contact",
          "label": "Contact",
          "i18n": "category.contact",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/contactName"
            },
            {
              "type": "Control",
              "scope": "#/properties/contactPhone"
            }
          ]
        },
        {
          "type": "Category",
          "name": "planning",
          "label": "Planning",
          "i18n": "category.planning",
          "elements": [
            {
