{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Equipment order",
  "required": ["contactName", "pickupCity"],
  "properties": {
    "contactName": {
      "type": "string",
      "title": "Contact name",
      "minLength": 3
    },
    "contactPhone": {
      "type": "string",
      "title": "Phone",
      "pattern": "^[0-9 +()-]{7,}$"
    },
    "pickupCity": { "type": "string", "title": "Pickup city" },
    "dropoffCity": { "type": "string", "title": "Drop-off city" },
    "itemCount": {
      "type": "integer",
      "title": "Items",
      "minimum": 1,
      "maximum": 8
    },
    "isBusiness": { "type": "boolean", "title": "Business account" },
    "companyName": { "type": "string", "title": "Company name" },
    "notes": { "type": "string", "title": "Notes for the driver" }
  }
}
