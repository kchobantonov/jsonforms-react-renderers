{
  "type": "object",
  "title": "Deployment notes",
  "properties": {
    "policy": {
      "type": "string",
      "title": "Access policy (JSON)"
    },
    "quiet": {
      "type": "string",
      "title": "Draft policy (JSON, not reported)"
    },
    "language": {
      "type": "string",
      "title": "Language",
      "oneOf": [
        {
          "const": "json",
          "title": "JSON"
        },
        {
          "const": "javascript",
          "title": "JavaScript"
        },
        {
          "const": "markdown",
          "title": "Markdown (no validator)"
        }
      ]
    },
    "snippet": {
      "type": "string",
      "title": "Snippet"
    },
    "summary": {
      "type": "string",
      "title": "Summary",
      "minLength": 5
    },
    "contact": {
      "type": "object",
      "title": "Contact",
      "properties": {
        "email": {
          "type": "string",
          "title": "Email"
        },
        "phone": {
          "type": "string",
          "title": "Phone"
        }
      }
    }
  },
  "required": ["summary"]
}
