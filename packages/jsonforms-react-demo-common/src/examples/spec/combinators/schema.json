{
  "type": "object",
  "properties": {
    "reference": {
      "type": "string",
      "title": "Request number"
    },
    "contact": {
      "type": "object",
      "title": "Who to contact",
      "properties": {
        "name": {
          "type": "string",
          "title": "Contact name"
        }
      },
      "oneOf": [
        {
          "title": "Email contact",
          "properties": {
            "kind": {
              "const": "email",
              "default": "email"
            },
            "email": {
              "type": "string",
              "title": "Email address"
            }
          },
          "required": [
            "kind",
            "email"
          ]
        },
        {
          "title": "Phone contact",
          "properties": {
            "kind": {
              "const": "phone",
              "default": "phone"
            },
            "phone": {
              "type": "string",
              "title": "Phone number",
              "default": ""
            }
          },
          "required": [
            "kind",
            "phone"
          ]
        }
      ]
    },
    "location": {
      "type": "object",
      "title": "Where to meet",
      "anyOf": [
        {
          "title": "On site",
          "properties": {
            "room": {
              "type": "string",
              "title": "Room"
            }
          },
          "required": [
            "room"
          ]
        },
        {
          "title": "Online",
          "properties": {
            "platform": {
              "type": "string",
              "title": "Platform"
            },
            "joinUrl": {
              "type": "string",
              "title": "Joining link"
            }
          },
          "required": [
            "platform"
          ]
        }
      ]
    },
    "equipment": {
      "type": "object",
      "title": "Equipment",
      "properties": {
        "name": {
          "type": "string",
          "title": "Item"
        }
      },
      "allOf": [
        {
          "title": "Identification",
          "properties": {
            "assetTag": {
              "type": "string",
              "title": "Asset tag",
              "minLength": 6,
              "maxLength": 6
            }
          }
        },
        {
          "title": "Condition",
          "properties": {
            "working": {
              "type": "boolean",
              "title": "In working order"
            }
          }
        }
      ]
    },
    "attendees": {
      "type": "integer",
      "title": "Number of attendees",
      "anyOf": [
        {
          "maximum": 12
        },
        {
          "minimum": 50
        }
      ]
    },
    "seatsPerTable": {
      "type": "integer",
      "title": "Seats per table",
      "oneOf": [
        {
          "multipleOf": 3
        },
        {
          "multipleOf": 5
        }
      ]
    },
    "urgent": {
      "type": "boolean",
      "title": "Urgent request"
    },
    "neededBy": {
      "type": "string",
      "title": "Needed by",
      "minLength": 1
    },
    "appointment": {
      "type": "object",
      "title": "How to send the summary",
      "properties": {
        "method": {
          "type": "string",
          "title": "Method",
          "enum": [
            "collect",
            "post",
            "none"
          ]
        }
      },
      "oneOf": [
        {
          "title": "Collect in person",
          "properties": {
            "method": {
              "const": "collect"
            },
            "collectionPoint": {
              "type": "string",
              "title": "Collection point"
            }
          },
          "required": [
            "method"
          ]
        },
        {
          "title": "By post",
          "properties": {
            "method": {
              "const": "post"
            },
            "postcode": {
              "type": "string",
              "title": "Postcode"
            },
            "addressLine": {
              "type": "string",
              "title": "Address"
            }
          },
          "required": [
            "method"
          ]
        },
        {
          "title": "Do not send",
          "properties": {
            "method": {
              "const": "none"
            }
          },
          "required": [
            "method"
          ]
        }
      ]
    }
  },
  "if": {
    "properties": {
      "urgent": {
        "const": true
      }
    },
    "required": [
      "urgent"
    ]
  },
  "then": {
    "required": [
      "neededBy"
    ]
  }
}
