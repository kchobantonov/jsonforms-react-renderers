{
  "type": "VerticalLayout",
  "options": {
    "gap": "1.5rem"
  },
  "elements": [
    {
      "type": "Control",
      "scope": "#/properties/reference"
    },
    {
      "type": "Categorization",
      "elements": [
        {
          "type": "Category",
          "name": "oneOf",
          "label": "oneOf",
          "elements": [
            {
              "type": "Label",
              "text": "A dropdown of branch labels. Switching branch asks first, then keeps the contact name."
            },
            {
              "type": "Control",
              "scope": "#/properties/contact"
            }
          ]
        },
        {
          "type": "Category",
          "name": "anyOf",
          "label": "anyOf",
          "elements": [
            {
              "type": "Label",
              "text": "Tabs over one value. Moving between them changes nothing and asks nothing."
            },
            {
              "type": "Control",
              "scope": "#/properties/location"
            }
          ]
        },
        {
          "type": "Category",
          "name": "allOf",
          "label": "allOf",
          "elements": [
            {
              "type": "Label",
              "text": "No selector: the enclosing property first, then every branch in schema order."
            },
            {
              "type": "Control",
              "scope": "#/properties/equipment"
            }
          ]
        },
        {
          "type": "Category",
          "name": "scalar",
          "label": "One input, several alternatives",
          "elements": [
            {
              "type": "Label",
              "text": "Composition that describes one scalar editor gets one input, not a branch selector."
            },
            {
              "type": "Control",
              "scope": "#/properties/attendees"
            },
            {
              "type": "Label",
              "text": "Up to 12 people, or 50 and over. Enter 30 to see the alternative-match failure."
            },
            {
              "type": "Control",
              "scope": "#/properties/seatsPerTable"
            },
            {
              "type": "Label",
              "text": "Multiples of three or of five, but not both: 6 and 10 pass, 15 does not."
            }
          ]
        },
        {
          "type": "Category",
          "name": "conditional",
          "label": "Schema condition vs UI rule",
          "elements": [
            {
              "type": "Label",
              "text": "The schema's if/then makes the date required. Only the UI rule hides it."
            },
            {
              "type": "Control",
              "scope": "#/properties/urgent"
            },
            {
              "type": "Group",
              "label": "With a UI rule",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/neededBy",
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/urgent",
                      "schema": {
                        "const": true
                      },
                      "failWhenUndefined": true
                    }
                  }
                }
              ]
            },
            {
              "type": "Group",
              "label": "Without a UI rule",
              "elements": [
                {
                  "type": "Label",
                  "text": "The same property, no rule. It stays on screen whatever the schema condition says."
                },
                {
                  "type": "Control",
                  "scope": "#/properties/neededBy",
                  "i18n": "neededByUnruled"
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "name": "schemaVisibility",
          "label": "Fields that appear from the schema",
          "elements": [
            {
              "type": "Label",
              "text": "Change the method. Different fields appear - decided by the schema alone, with no UI rule anywhere."
            },
            {
              "type": "Control",
              "scope": "#/properties/appointment"
            },
            {
              "type": "Label",
              "text": "Collect asks for a collection point, Post asks for an address, Do not send asks for nothing."
            }
          ]
        }
      ]
    }
  ]
}
