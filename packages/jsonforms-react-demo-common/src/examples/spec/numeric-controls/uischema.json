{
  "type": "VerticalLayout",
  "elements": [
    { "type": "Label", "text": "Integer entry" },
    { "type": "Control", "scope": "#/properties/quantity" },
    {
      "type": "Control",
      "scope": "#/properties/batchCount",
      "options": { "step": 2 }
    },
    { "type": "Separator" },
    { "type": "Label", "text": "Number entry" },
    {
      "type": "Control",
      "scope": "#/properties/unitPrice",
      "options": { "step": 0.01, "placeholder": "0.00" }
    },
    { "type": "Control", "scope": "#/properties/weightKg" },
    { "type": "Control", "scope": "#/properties/toleranceMm" },
    { "type": "Separator" },
    { "type": "Label", "text": "The same number as a slider" },
    {
      "type": "Control",
      "scope": "#/properties/discountPercent",
      "options": { "slider": true }
    }
  ]
}
