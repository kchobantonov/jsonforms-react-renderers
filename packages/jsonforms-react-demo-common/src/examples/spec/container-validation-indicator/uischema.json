{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Control",
      "scope": "#/properties/fullName"
    },
    {
      "type": "Categorization",
      "options": {
        "variant": "stepper",
        "showNavButtons": true
      },
      "elements": [
        {
          "type": "Category",
          "name": "personal",
          "label": "Personal details",
          "i18n": "personalDetails",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/startDate"
            },
            {
              "type": "Group",
              "label": "Emergency contact",
              "i18n": "emergencyContact",
              "options": {
                "collapsible": true,
                "collapsed": true,
                "showDataIndicator": true,
                "showValidationIndicator": true
              },
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/emergencyContact/properties/name"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/emergencyContact/properties/relationship"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/emergencyContact/properties/phone"
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "name": "compliance",
          "label": "Compliance",
          "i18n": "compliance",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/certifications",
              "options": {
                "showValidationIndicator": false,
                "elementLabelProp": "name",
                "showSortButtons": true
              }
            }
          ]
        }
      ]
    }
  ]
}
