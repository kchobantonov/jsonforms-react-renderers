{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["fullName", "emergencyContact"],
  "properties": {
    "fullName": {
      "type": "string",
      "minLength": 1,
      "title": "Full name",
      "description": "Name as it appears on the employment contract."
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "title": "Start date"
    },
    "emergencyContact": {
      "type": "object",
      "title": "Emergency contact",
      "required": ["name", "phone"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "title": "Contact name"
        },
        "relationship": {
          "type": "string",
          "title": "Relationship",
          "enum": ["Partner", "Parent", "Sibling", "Friend"]
        },
        "phone": {
          "type": "string",
          "minLength": 7,
          "title": "Phone number",
          "description": "Include the country code, for example +359 2 000 0000."
        }
      }
    },
    "certifications": {
      "type": "array",
      "title": "Certifications",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "expiresOn"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Certificate"
          },
          "expiresOn": {
            "type": "string",
            "format": "date",
            "title": "Expires on"
          }
        }
      }
    }
  }
}
