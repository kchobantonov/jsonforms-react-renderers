{
  "type": "VerticalLayout",
  "elements": [
    { "type": "Control", "scope": "#/properties/username" },
    { "type": "Label", "text": "Selected by the schema format" },
    { "type": "Control", "scope": "#/properties/password" },
    { "type": "Separator" },
    { "type": "Label", "text": "Selected by options.format on a plain string" },
    {
      "type": "Control",
      "scope": "#/properties/recoveryPhrase",
      "options": { "format": "password" }
    },
    { "type": "Control", "scope": "#/properties/hint" },
    { "type": "Separator" },
    {
      "type": "Label",
      "text": "A fixed-length code: the same password, drawn one character per box"
    },
    {
      "type": "Control",
      "scope": "#/properties/verificationCode",
      "options": { "variant": "otp" }
    },
    {
      "type": "Control",
      "scope": "#/properties/backupCode",
      "options": { "variant": "otp" }
    },
    { "type": "Separator" },
    { "type": "Label", "text": "Masking survives inside a table cell" },
    {
      "type": "Control",
      "scope": "#/properties/serviceAccounts",
      "options": { "table": true }
    }
  ]
}
