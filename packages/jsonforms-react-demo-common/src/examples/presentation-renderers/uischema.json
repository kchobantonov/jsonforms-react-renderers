{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Label",
      "text": "Image View with alternative text"
    },
    {
      "type": "ImageView",
      "options": {
        "src": "data:image/svg+xml;base64,",
        "alt": "Blue circle beside the words Presentation renderers"
      }
    },
    {
      "type": "Spacer"
    },
    {
      "type": "Label",
      "text": "Default Spacer above: 32 pixels"
    },
    {
      "type": "Separator"
    },
    {
      "type": "Control",
      "scope": "#/properties/name"
    },
    {
      "type": "Spacer",
      "options": {
        "height": 64
      }
    },
    {
      "type": "Label",
      "text": "Custom Spacer above: 64 pixels"
    },
    {
      "type": "Control",
      "scope": "#/properties/notes",
      "options": {
        "multi": true
      }
    },
    {
      "type": "Separator"
    },
    {
      "type": "Label",
      "text": "Separators, spacers and images are presentation-only elements."
    }
  ]
}
