        {
          "type": "HorizontalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/firstName",
              "options": {
                "columns": 4
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Group",
      "label": "Fixed plus Auto",
      "elements": [
        {
          "type": "HorizontalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/firstName",
              "options": {
                "columns": 4
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/lastName"
            }
          ]
        }
      ]
    },
    {
      "type": "Group",
      "label": "Fixed plus two Auto",
      "elements": [
        {
          "type": "HorizontalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/firstName",
              "options": {
                "columns": 4
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/lastName"
            },
            {
              "type": "Control",
              "scope": "#/properties/notes"
            }
          ]
        }
      ]
    },
    {
      "type": "Group",
      "label": "Fixed widths leave unused space",
      "elements": [
        {
          "type": "HorizontalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/firstName",
              "options": {
                "columns": 4
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/lastName",
              "options": {
                "columns": 4
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Group",
      "label": "Overflow wraps in order",
      "elements": [
        {
          "type": "HorizontalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/firstName",
              "options": {
                "columns": 12
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/lastName",
              "options": {
                "columns": 8
              }
            },
            {
