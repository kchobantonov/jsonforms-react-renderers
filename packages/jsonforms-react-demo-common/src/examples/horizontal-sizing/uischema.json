              "scope": "#/properties/notes"
            }
          ]
        }
      ]
    },
    {
      "type": "Group",
      "label": "All Auto, equal thirds",
      "elements": [
        {
          "type": "HorizontalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/firstName"
            },
            {
              "type": "Control",
              "scope": "#/properties/lastName"
            },
            {
              "type": "Control",
              "scope": "#/properties/notes"
            }
          ]
        }
      ]
    },
    {
      "type": "Group",
      "label": "Presentation and nested layout",
      "elements": [
        {
          "type": "HorizontalLayout",
          "elements": [
            {
              "type": "Label",
              "text": "Quarter-width label",
              "options": {
                "columns": 4
              }
            },
            {
              "type": "Group",
              "label": "Nested group",
              "options": {
                "columns": 8
              },
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/notes"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Group",
      "label": "Hidden field releases its slot",
      "elements": [
        {
          "type": "HorizontalLayout",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/firstName",
              "options": {
                "columns": 4
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/showDetails",
                  "schema": {
                    "const": true
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/lastName"
            }
          ]
        }
      ]
    }
