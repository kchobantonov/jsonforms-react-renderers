{
  "name": "@chobantonov/jsonforms-react-renderer-common",
  "version": "0.0.1",
  "description": "UI-independent JSON Forms React renderer behavior",
  "license": "MIT",
  "main": "lib/index.cjs.js",
  "module": "lib/index.esm.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.esm.js",
      "require": "./lib/index.cjs.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "import": "./lib/*.esm.js",
      "require": "./lib/*.cjs.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/*"
      ]
    }
  },
  "scripts": {
    "build": "vp build && tsc --emitDeclarationOnly && tsc --noEmit -p test/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vp test run",
    "clean": "rimraf lib coverage",
    "lint": "vp lint .",
    "lint:fix": "vp run lint --fix"
  },
  "dependencies": {
    "@marcbachmann/cel-js": "8.0.0",
    "ajv": "^8.20.0",
    "dayjs": "^1.11.11",
    "lodash": "^4.18.1",
    "maska": "^3.2.1"
  },
  "peerDependencies": {
    "@jsonforms/core": "catalog:",
    "@jsonforms/react": "catalog:",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@jsonforms/core": "catalog:",
    "@jsonforms/react": "catalog:",
    "@types/lodash": "^4.14.149",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^22.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^3.0.2",
    "tslib": "^2.5.0",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kchobantonov/jsonforms-react-renderers.git",
    "directory": "packages/jsonforms-react-renderer-common"
  }
}
